# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el ".env" a git (ya está en .gitignore).

# --- Usado por app/ (Streamlit) en desarrollo local ---------------------
# Alternativa a rellenar .streamlit/secrets.toml. En producción
# (Streamlit Community Cloud u otro hosting) usa siempre secrets.toml
# o el gestor de secretos de tu plataforma, nunca variables de entorno
# en texto plano si puedes evitarlo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave ANÓNIMA (anon/public): la usa SOLO la app de Streamlit, que solo
# necesita permiso de lectura (ver política de RLS en sql/schema.sql).
SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLIC

# --- Usado por ingest/ (GitHub Actions / ejecución local de la ingesta) -
# Clave de SERVICE ROLE: bypassa la Row Level Security, así que tiene
# permiso de escritura. Guárdala SOLO como secret de GitHub Actions
# (Settings -> Secrets and variables -> Actions) o en tu .env local si
# vas a lanzar la ingesta a mano. Nunca la metas en el frontend ni la
# subas al repositorio.
SUPABASE_SERVICE_KEY=TU_CLAVE_SERVICE_ROLE
