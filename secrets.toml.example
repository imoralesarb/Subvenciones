# Copia este archivo a ".streamlit/secrets.toml" y rellena los valores
# reales. NUNCA subas secrets.toml a git (ya está en .gitignore).
#
# En Streamlit Community Cloud: pega este mismo contenido (con los
# valores reales) en el panel de la app -> Settings -> Secrets.

SUPABASE_URL = "https://TU-PROYECTO.supabase.co"

# Clave ANÓNIMA (anon/public) — nunca la Service Role Key aquí: esta
# app es pública y la clave viajaría al navegador del usuario.
SUPABASE_ANON_KEY = "TU_CLAVE_ANON_PUBLIC"
